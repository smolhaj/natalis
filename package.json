{
  "name": "natalis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fast": "vitest run --exclude \"**/engineBalance.test.js\" --exclude \"**/engineRobustness.test.js\" --exclude \"**/simulation.test.js\" --exclude \"**/demography.test.js\"",
    "test:sim": "vitest run tests/engineBalance.test.js tests/engineRobustness.test.js tests/simulation.test.js tests/demography.test.js",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-flags": "node scripts/check-flags.js",
    "check-events": "node scripts/check-events.js",
    "sim": "node scripts/sim.js",
    "check-anachronisms": "node scripts/check-anachronisms.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.61.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vitest": "^4.1.9"
  }
}
